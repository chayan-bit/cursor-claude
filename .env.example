# Port the local proxy listens on (default 8787)
PORT=8787

# Bind address. Keep 127.0.0.1 unless you know what you are doing.
HOST=127.0.0.1

# Optional: a shared secret Cursor must send as the API key.
# If set, requests without "Authorization: Bearer <this>" (or x-api-key)
# are rejected. Leave empty to accept any key (fine for localhost only).
PROXY_API_KEY=

# Where OAuth credentials are stored. Defaults to ~/.cursor-claude/credentials.json
# CREDENTIALS_PATH=
